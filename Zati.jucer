  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android"
                   smallIcon="icoApp" bigIcon="icoApp"
                   androidActivityClass="com.artifacts.zati.Zati"
                   androidMinimumSDK="24" androidTargetSDK="36"
                   androidInternetNeeded="0" androidCpp11="1"
                   microphonePermissionNeeded="1"
                   androidReadMediaAudioPermission="1" androidReadMediaImagesPermission="0" androidReadMediaVideoPermission="0" androidExternalWriteNeeded="1"
                   androidTheme="@style/ZatiLaunch"
                   androidScreenOrientation="unspecified"
                   gradleVersion="8.11.1" androidPluginVersion="8.9.1"
                   extraLinkerFlags="-Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug"   isDebug="1" targetName="Zati" androidArchitectures="arm64-v8a"/>
        <CONFIGURATION name="Release" isDebug="0" targetName="Zati" optimisation="3" androidArchitectures="arm64-v8a"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
