      <FILE id="srcSgd"  name="StepGrid.h"        compile="0" resource="0" file="Source/StepGrid.h"/>
      <FILE id="srcAp"   name="AudioPath.h"       compile="0" resource="0" file="Source/AudioPath.h"/>
      <FILE id="srcExp"  name="Exporter.h"        compile="0" resource="0" file="Source/Exporter.h"/>
      <FILE id="srcCfh"  name="CommandFifo.h"     compile="0" resource="0" file="Source/CommandFifo.h"/>
      <FILE id="srcWfh"  name="WaveformDisplay.h" compile="0" resource="0" file="Source/WaveformDisplay.h"/>
      <FILE id="srcSph"  name="SpectrumDisplay.h" compile="0" resource="0" file="Source/SpectrumDisplay.h"/>
      <FILE id="srcLnf"  name="ZatiLookAndFeel.h" compile="0" resource="0" file="Source/ZatiLookAndFeel.h"/>
      <FILE id="srcLcpp" name="SampleLoader.cpp"  compile="1" resource="0" file="Source/SampleLoader.cpp"/>
      <FILE id="srcFcpp" name="AudioFocus.cpp"    compile="1" resource="0" file="Source/AudioFocus.cpp"/>
      <FILE id="srcLgc"  name="Lang.cpp"          compile="1" resource="0" file="Source/Lang.cpp"/>
      <FILE id="srcLgh"  name="Lang.h"            compile="0" resource="0" file="Source/Lang.h"/>
      <FILE id="srcSIc"  name="SystemInsets.cpp"  compile="1" resource="0" file="Source/SystemInsets.cpp"/>
      <FILE id="srcSIh"  name="SystemInsets.h"    compile="0" resource="0" file="Source/SystemInsets.h"/>
      <FILE id="srcDTc"  name="DeviceTier.cpp"    compile="1" resource="0" file="Source/DeviceTier.cpp"/>
      <FILE id="srcDTh"  name="DeviceTier.h"      compile="0" resource="0" file="Source/DeviceTier.h"/>
      <FILE id="srcFh"   name="AudioFocus.h"      compile="0" resource="0" file="Source/AudioFocus.h"/>
      <FILE id="srcSKc"  name="SessionKeeper.cpp" compile="1" resource="0" file="Source/SessionKeeper.cpp"/>
      <FILE id="srcASh"  name="AppStorage.h"    compile="0" resource="0" file="Source/AppStorage.h"/>
      <FILE id="srcASc"  name="AppStorage.cpp"  compile="1" resource="0" file="Source/AppStorage.cpp"/>
      <FILE id="srcMSc"  name="MediaStore.cpp"  compile="1" resource="0" file="Source/MediaStore.cpp"/>
      <FILE id="srcSKh"  name="SessionKeeper.h"   compile="0" resource="0" file="Source/SessionKeeper.h"/>
      <FILE id="srcLh"   name="SampleLoader.h"    compile="0" resource="0" file="Source/SampleLoader.h"/>
      <FILE id="srcPsh"  name="ProjectStore.h"    compile="0" resource="0" file="Source/ProjectStore.h"/>
      <FILE id="srcZth"  name="Zati.h"            compile="0" resource="0" file="Source/Zati.h"/>
      <FILE id="srcSnc"  name="Sintes.cpp"        compile="1" resource="0" file="Source/Sintes.cpp"/>
      <FILE id="srcSnh"  name="Sintes.h"          compile="0" resource="0" file="Source/Sintes.h"/>
      <FILE id="srcSni"  name="SintesTabla.inc"   compile="0" resource="0" file="Source/SintesTabla.inc"/>
      <FILE id="srcEq5"  name="Eq5.h"             compile="0" resource="0" file="Source/Eq5.h"/>
      <FILE id="srcEqc"  name="EqCurve.h"         compile="0" resource="0" file="Source/EqCurve.h"/>
      <FILE id="srcDin"  name="Dinamica.h"        compile="0" resource="0" file="Source/Dinamica.h"/>
    </GROUP>
    <GROUP id="ZatiKits" name="kits">
    </GROUP>
    <GROUP id="ZatiFonts" name="fonts">
      <FILE id="fntOsB" name="OswaldBold.ttf"          compile="0" resource="1" file="Source/fonts/OswaldBold.ttf"/>
      <FILE id="fntOsM" name="OswaldMedium.ttf"        compile="0" resource="1" file="Source/fonts/OswaldMedium.ttf"/>
      <FILE id="fntJbR" name="JetBrainsMonoRegular.ttf" compile="0" resource="1" file="Source/fonts/JetBrainsMonoRegular.ttf"/>
      <FILE id="fntJbB" name="JetBrainsMonoBold.ttf"    compile="0" resource="1" file="Source/fonts/JetBrainsMonoBold.ttf"/>
    </GROUP>
    <GROUP id="ZatiIcons" name="icons">
      <FILE id="icoApp" name="icon.png" compile="0" resource="0" file="ci/icon.png"/>
    </GROUP>
  </MAINGROUP>
  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android"
                   smallIcon="icoApp" bigIcon="icoApp"
                   androidActivityClass="com.artifacts.zati.Zati"
                   androidMinimumSDK="24" androidTargetSDK="36"
                   androidInternetNeeded="0" androidCpp11="1"
                   microphonePermissionNeeded="1"
                   androidReadMediaAudioPermission="1" androidReadMediaImagesPermission="0" androidReadMediaVideoPermission="0" androidExternalWriteNeeded="1"
                   androidTheme="@style/ZatiLaunch"
                   androidPushNotifications="0"
                   androidScreenOrientation="unspecified"
                   gradleVersion="8.13" gradleWrapperVersion="8.13.2"
                   extraLinkerFlags="-Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug"   isDebug="1" targetName="Zati" androidArchitectures="arm64-v8a"/>
        <CONFIGURATION name="Release" isDebug="0" targetName="Zati" optimisation="3" androidArchitectures="arm64-v8a"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_core"              path="JUCE/modules"/>
        <MODULEPATH id="juce_events"            path="JUCE/modules"/>
        <MODULEPATH id="juce_graphics"          path="JUCE/modules"/>
        <MODULEPATH id="juce_data_structures"   path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics"        path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra"         path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_basics"      path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices"     path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats"     path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors"  path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors_headless" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils"       path="JUCE/modules"/>
        <MODULEPATH id="juce_dsp"               path="JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>
  <MODULES>
    <MODULE id="juce_audio_basics"     showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices"    showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats"    showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors_headless" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils"      showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core"             showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures"  showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_dsp"              showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events"           showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics"         showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics"       showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra"        showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <JUCEOPTIONS JUCE_USE_ANDROID_OBOE="1" JUCE_STRICT_REFCOUNTEDPOINTER="1"
               JUCE_WEB_BROWSER="0" JUCE_USE_CURL="0" JUCE_USE_MP3AUDIOFORMAT="1"/>
  <LIVE_SETTINGS>
    <LINUX/>
  </LIVE_SETTINGS>
</JUCERPROJECT>
