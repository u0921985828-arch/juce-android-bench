# Build output
build/
cmake-build-*/
out/

# JUCE is fetched via FetchContent into the build tree — never vendored
_deps/

# Projucer-generated output (CI regenerates both via --resave)
Builds/
JuceLibraryCode/

# La release descargada para comprobar firma y permisos. Son 14 MB de binario
# que el workflow vuelve a producir en cada corrida: versionarlo solo engorda
# el historial con un artefacto reproducible.
*.apk
*.aab

# Las imagenes de la ficha de Play: las hace Tests/store.py en un minuto,
# asi que la fuente es el script y no 34 PNG en el historial.
/store/

# Local validation scaffolding (not part of the repo)
JUCE
pjbuild/
pj_*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
*.user
.agents/

#  Las HABILIDADES si van al repositorio, y el resto de .claude no. Aqui dentro
#  hay dos cosas distintas: el ESTADO de la sesion -credenciales, historial,
#  ajustes de la maquina- que no es de nadie mas, y las habilidades, que son
#  documentacion del proyecto igual que CLAUDE.md. Ignorar la carpeta entera
#  dejo `banco` fuera del commit que decia haberlo anadido: existia en el disco
#  del contenedor, se perdia al reciclarse, y nadie que clonara el repositorio
#  lo tenia.
.claude/*
!.claude/skills/
skills-lock.json

# El .pyc que deja importar un banco desde otro
__pycache__/
*.pyc
